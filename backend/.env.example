# ══════════════════════════════════════════════════════════════
#  EUR/CHF AI Trading System — Environment Variables
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════

# ── Groq AI (FREE) ────────────────────────────────────────────
# Get key: https://console.groq.com
# Model used: qwen/qwen3-32b
GROQ_API_KEY=your_groq_api_key_here

# ── Pepperstone cTrader Open API ──────────────────────────────
# Step 1: Open Pepperstone account → https://www.pepperstone.com
#         Nigerian traders: register under Pepperstone Bahamas entity
# Step 2: Register your app at → https://openapi.ctrader.com
#         Click "Create Application" → copy client_id + client_secret
# Step 3: Authorize your account to get an access_token
#         POST https://connect.spotware.com/apps/token
#         with grant_type=client_credentials
# Step 4: Find your account ID in your cTrader portal

CTRADER_CLIENT_ID=your_ctrader_client_id_here
CTRADER_CLIENT_SECRET=your_ctrader_client_secret_here
CTRADER_ACCESS_TOKEN=your_ctrader_access_token_here

# Optional — auto-fetched if left blank
CTRADER_ACCOUNT_ID=

# ── Twelve Data (FREE fallback market data) ───────────────────
# Used automatically if Pepperstone data fetch fails.
# Free tier: 800 calls/day — more than enough.
# Get key: https://twelvedata.com (sign up free)
# Leave as 'demo' to test with limited rate.
TWELVE_DATA_API_KEY=demo

# ── App settings ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
